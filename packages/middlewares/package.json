{
	"name": "@lithia-js/middlewares",
	"version": "1.0.0-canary.27",
	"description": "Reusable middleware utilities for Lithia.js applications.",
	"keywords": [
		"lithia",
		"lithia-js",
		"middlewares",
		"validation",
		"zod"
	],
	"author": "Lucas Arch <luketsx@icloud.com>",
	"license": "MIT",
	"homepage": "https://lithiajs.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lithia-framework/lithia.git",
		"directory": "packages/middlewares"
	},
	"bugs": {
		"url": "https://github.com/lithia-framework/lithia/issues"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup --config tsup.config.ts"
	},
	"peerDependencies": {
		"@lithia-js/core": "workspace:1.0.0-canary.27",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@lithia-js/core": "workspace:1.0.0-canary.27"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public",
		"provenance": true
	}
}
