	},
	"dependencies": {
		"@lithia-js/core": "workspace:*",
		"@lithia-js/utils": "workspace:*",
		"citty": "^0.2.0",
		"chokidar": "^5.0.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public",
		"provenance": true
	}
