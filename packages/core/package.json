{
	"name": "@lithia-js/core",
	"version": "1.0.0-canary.9",
	"private": false,
	"type": "module",
	"author": "Lucas Arch <luketsx@icloud.com>",
	"homepage": "https://lithiajs.com",
	"license": "MIT",
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./config": {
			"types": "./dist/config/index.d.mts",
			"default": "./dist/config/index.mjs"
		},
		"./hooks": {
			"types": "./dist/runtime/hooks/index.d.mts",
			"default": "./dist/runtime/hooks/index.mjs"
		},
		"./server": {
			"types": "./dist/runtime/server/index.d.mts",
			"default": "./dist/runtime/server/index.mjs"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@types/busboy": "^1.5.4",
		"@types/source-map-support": "^0.5.10"
	},
	"dependencies": {
		"@lithia-js/native": "workspace:*",
		"@lithia-js/utils": "workspace:*",
		"busboy": "^1.6.0",
		"c12": "^3.3.3",
		"cookie": "^1.1.1",
		"klona": "^2.0.6",
		"socket.io": "^4.8.1",
		"source-map-support": "^0.5.21",
		"zod": "^4.2.1"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lithia-framework/lithia.git"
	},
	"bugs": {
		"url": "https://github.com/lithia-framework/lithia/issues"
	}
}
