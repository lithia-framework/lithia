{
	"name": "@lithia-js/openapi",
	"version": "1.0.0-canary.29",
	"description": "OpenAPI and Scalar integration for Lithia.js.",
	"keywords": [
		"lithia",
		"lithia-js",
		"openapi",
		"scalar",
		"zod",
		"docs"
	],
	"author": "Lucas Arch <luketsx@icloud.com>",
	"license": "MIT",
	"homepage": "https://lithiajs.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lithia-framework/lithia.git",
		"directory": "packages/openapi"
	},
	"bugs": {
		"url": "https://github.com/lithia-framework/lithia/issues"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"assets"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup --config tsup.config.ts",
		"test": "vitest --run"
	},
	"dependencies": {
		"zod": "^4.2.1"
	},
	"peerDependencies": {
		"@lithia-js/core": "workspace:1.0.0-canary.29"
	},
	"devDependencies": {
		"@lithia-js/core": "workspace:1.0.0-canary.29"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public",
		"provenance": true
	}
}
