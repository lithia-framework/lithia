{
  "name": "@lithia-js/native",
  "version": "1.0.0-canary.14",
  "description": "The high-performance native core of Lithia.js, powered by Rust.",
  "keywords": [
    "lithia",
    "lithia-js",
    "rust",
    "napi-rs",
    "native-bindings",
    "compiler",
    "performance"
  ],
  "author": "Lucas Arch <luketsx@icloud.com>",
  "license": "MIT",
  "homepage": "https://lithiajs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lithia-framework/lithia.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/lithia-framework/lithia/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node sync-versions.js",
    "build:rs": "pnpm prebuild && napi build --platform --release",
    "artifacts": "napi artifacts --npm-dir npm",
    "prepublishOnly": "napi prepublish -p npm --tag-style npm --no-gh-release"
  },
  "napi": {
    "binaryName": "lithia",
    "targets": [
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "i686-pc-windows-msvc",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  }
}