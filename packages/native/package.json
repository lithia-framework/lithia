{
  "name": "@lithia-js/native",
  "version": "1.0.0-canary.3",
  "private": false,
  "main": "index.js",
  "types": "index.d.ts",
  "author": "Lucas Arch <luketsx@icloud.com>",
  "homepage": "https://lithiajs.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lithia-framework/lithia.git"
  },
  "bugs": {
    "url": "https://github.com/lithia-framework/lithia/issues"
  },
  "scripts": {
    "prepublishOnly": "napi prepublish -p npm --tag-style npm --no-gh-release",
    "artifacts": "napi artifacts --npm-dir npm",
    "build:rs": "napi build --platform --release"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "lithia",
    "targets": [
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "i686-pc-windows-msvc",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.js"
    }
  }
}