{
  "name": "my-lithia-app",
  "version": "0.1.0",
  "private": true,
  "description": "Lithia template with Better Auth and Drizzle integration.",
  "type": "module",
  "scripts": {
    "dev": "lithia dev",
    "build": "lithia build",
    "start": "node ./dist/server.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@lithia-js/better-auth": "file:../../packages/better-auth",
    "@lithia-js/core": "file:../../packages/core",
    "@lithia-js/middlewares": "file:../../packages/middlewares",
    "@lithia-js/openapi": "file:../../packages/openapi",
    "better-auth": "^1.4.17",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@lithia-js/cli": "file:../../packages/cli",
    "@types/node": "^25.1.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
