{
  "name": "lithia",
  "version": "5.0.0-canary.0",
  "description": "Next-generation framework for building server-side applications with Node.js & TypeScript 🚀",
  "keywords": [
    "lithia",
    "framework",
    "typescript",
    "nodejs",
    "node",
    "api",
    "server",
    "backend",
    "file-based-routing",
    "hot-reload",
    "web-framework",
    "rest-api",
    "developer-experience",
    "dx"
  ],
  "author": {
    "name": "Lithia Team",
    "email": "support@lithiajs.com",
    "url": "https://lithiajs.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lithia-framework/lithia.git"
  },
  "homepage": "https://lithiajs.com",
  "bugs": {
    "url": "https://github.com/lithia-framework/lithia/issues"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/lithiajs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@8.15.0",
  "bin": {
    "lithia": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsx build.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "examples": "tsx examples/example-runner.ts",
    "studio": "cd studio && npm run dev",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.9",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.3",
    "@types/prompts": "^2.4.9",
    "@types/serve-static": "^2.2.0",
    "prompts": "^2.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@swc/core": "^1.15.5",
    "c12": "^3.3.3",
    "chokidar": "^5.0.0",
    "citty": "^0.1.6",
    "cli-table3": "^0.6.5",
    "cookie": "^1.1.1",
    "glob": "^13.0.0",
    "hookable": "^5.5.3",
    "import-fresh": "^3.3.1",
    "klona": "^2.0.6",
    "serve-static": "^2.2.1",
    "socket.io": "^4.8.1",
    "std-env": "^3.10.0",
    "tslib": "^2.8.1",
    "ufo": "^1.6.1",
    "zod": "^4.2.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
