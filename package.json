{
  "name": "lithia-framework",
  "version": "1.0.0-canary.24",
  "private": true,
  "description": "File-based Node.js backend framework with worker-powered runtime isolation and native ESM.",
  "packageManager": "pnpm@10.0.0",
  "author": "Lucas Arch <luketsx@icloud.com>",
  "homepage": "https://lithiajs.org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lithia-framework/lithia.git"
  },
  "bugs": {
    "url": "https://github.com/lithia-framework/lithia/issues"
  },
  "keywords": [
    "lithia",
    "framework",
    "node",
    "esm-only",
    "typescript",
    "backend",
    "api",
    "file-based-routing",
    "workers",
    "async-tasks",
    "openapi",
    "monorepo",
    "turborepo"
  ],
  "scripts": {
    "build": "turbo build --filter='./packages/*'",
    "test": "turbo test --filter='./packages/*'",
    "format": "biome format --write",
    "lint": "biome check",
    "version:set": "node ./scripts/set-version.mjs",
    "version:sync": "node ./scripts/sync-versions.mjs",
    "release:check": "node ./scripts/check-release.mjs",
    "release:tag": "node ./scripts/create-release-tag.mjs",
    "release:publish": "node ./scripts/publish-release.mjs",
    "release:github": "node ./scripts/github-release.mjs",
    "release": "pnpm release:check && pnpm build && pnpm test && pnpm release:publish && pnpm release:github"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@types/node": "^25.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.7.6",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
